---
interface Props {
  title?: string
}

const { title = 'Skip to content' } = Astro.props
---


<a id="skiplink" href="#main-content">{title}</a>



<style>
  #skiplink {
    position: absolute;
    top: -6rem;
    z-index: 1000;
    padding: .4em;
    background-color: var(--background-colour);
  }

  #skiplink:focus-visible {
    top: 1.6rem; left: 1.6rem;
  }
</style>
